<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Per-user LaunchAgent. "make install-launchd" fills in __BIN__ and __HOME__. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.haobot.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BIN__</string>
		<string>serve</string>
		<string>-data</string>
		<string>__HOME__/.haobot</string>
		<string>-listen</string>
		<string>127.0.0.1</string>
		<string>-port</string>
		<string>9081</string>
		<!-- Unlock the SIM from the login keychain; remove if the SIM has no PIN.
		     Store it with: security add-generic-password -s haobot-pin -a haobot -w -->
		<string>-sim-pin-keychain</string>
		<string>haobot-pin</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/haobot-agent.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/haobot-agent.log</string>
</dict>
</plist>
