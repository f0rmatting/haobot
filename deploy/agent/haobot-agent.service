[Unit]
Description=号小助 haobot agent (SMS and call assistant for a cellular modem)
After=network.target

[Service]
# Serial transport through the kernel option driver. Every recognised modem
# is discovered (its AT port, e.g. /dev/ttyUSB2, is found through sysfs); add
# -device /dev/ttyUSB2,/dev/ttyUSB6 to pin specific ports instead.
# For -transport usb, install 99-ec20.rules.
ExecStart=/usr/local/bin/haobot-agent serve -data /var/lib/haobot -listen 127.0.0.1 -port 9081 -transport serial
# Optional SIM PIN (file containing only the digits, mode 600):
# ExecStart=... -sim-pin-file /etc/haobot/pin
StateDirectory=haobot
DynamicUser=yes
# plugdev (with 99-ec20.rules installed) lets automatic recovery reset the USB device.
SupplementaryGroups=dialout plugdev
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
